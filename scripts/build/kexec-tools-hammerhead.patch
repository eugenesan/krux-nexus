+/* Android kernels are zImage-dtb: the DTB is appended after the
+ * compressed image.  kexec-tools otherwise extracts a separate DTB
+ * and passes it in r2, which the 3.4 decompressor does not expect.
+ * Keep the appended DTB and let the decompressor find it. */
+static int has_appended_dtb(const char *buf, off_t len)
+{
+	off_t i;
+
+	for (i = len - 8; i >= 0; i--) {
+		uint32_t total;
+
+		if ((unsigned char)buf[i] != 0xd0 ||
+		    (unsigned char)buf[i + 1] != 0x0d ||
+		    (unsigned char)buf[i + 2] != 0xfe ||
+		    (unsigned char)buf[i + 3] != 0xed)
+			continue;
+		total = ((uint32_t)(unsigned char)buf[i + 4] << 24) |
+			((uint32_t)(unsigned char)buf[i + 5] << 16) |
+			((uint32_t)(unsigned char)buf[i + 6] << 8) |
+			(uint32_t)(unsigned char)buf[i + 7];
+		if (total > 0 && i + total <= len)
+			return 1;
+	}
+	return 0;
+}
