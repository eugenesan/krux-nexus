#!/sbin/sh
# enable-adb -- bring up adbd and the USB adb gadget on demand.
#
# The sealed image keeps adb off at boot (the stub stops adbd and does
# not wait for a host).  Run this from TWRP's terminal, or
# 'sh /sbin/enable-adb' from the recovery shell, when adb is needed --
# for example to sideload an Android update.
#
# TWRP's init.recovery.usb.rc already knows how to configure the
# gadget: 'sys.usb.config=adb' writes the android_usb attributes and
# starts adbd.  The property may already be "adb" from boot, so clear
# it first to make the handler fire again.
setprop sys.usb.config none
sleep 1
setprop sys.usb.config adb
setprop sys.usb.state adb
# Covers the case where the property did not change (no rc handler).
setprop ctl.start adbd
echo "adb: $(getprop sys.usb.state)"
