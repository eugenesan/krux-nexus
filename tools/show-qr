#!/usr/bin/env python3
"""Show a QR code on the tablet, at an exact and verified size.

The tablet's gallery scales an image to fit, so the code on the screen
is not the size it was drawn at.  That does not matter as long as the
size is *known*: the corpus records what the camera actually sees.

So this tool draws the code, shows it, takes the tablet's own
screenshot, measures the module pitch on the screen, and reports it.
If the pitch is not what was asked for, it works out the gallery's
scale and draws the code again, until the screen really shows the
requested pixels per module.

The tablet's screen goes off after a while; it is woken and kept
awake here.

  show-qr --target v20-dense --module-px 6
  show-qr --payload HELLO --version 7 --module-px 8
"""

import argparse
import json
import os
import subprocess
import time

import numpy as np
import qrcode
from PIL import Image, ImageDraw

TABLET = "41036f02470031ff"
TARGETS = os.environ.get("QR_TARGETS", "/tmp/qr-targets")
SCREEN_W, SCREEN_H = 1280, 800
EC_MAP = {"L": 1, "M": 0, "Q": 3, "H": 2}


def adb(*args, **kw):
    return subprocess.run(["adb", "-s", TABLET] + list(args),
                          capture_output=True, text=True, **kw)


def is_awake():
    out = adb("shell", "dumpsys power").stdout or ""
    return "mWakefulness=Awake" in out


def wake(brightness=255):
    """Keep the tablet awake, at a fixed brightness.

    It must NOT send a synthetic touch: this tablet's panel blinks on
    every touch event, and a blink puts a dark frame in the middle of a
    capture.  The stay-on setting and, only when it is actually
    asleep, the WAKEUP key are enough.
    """
    # The screensaver and the screen timeout both have to go, or the
    # tablet falls asleep in the middle of a capture and shows nothing.
    adb("shell", "settings put secure screensaver_enabled 0")
    adb("shell", "settings put secure screensaver_activate_on_sleep 0")
    adb("shell", "settings put secure screensaver_activate_on_dock 0")
    # stay_on_while_plugged_in 3 keeps the screen on for every charging
    # source, not just USB; 2 is USB only and the tablet was still
    # sleeping on mains.
    adb("shell", "settings put global stay_on_while_plugged_in 3")
    adb("shell", "settings put system screen_off_timeout 1800000")
    adb("shell", "svc power stayon true")
    # The screensaver dims the panel after a while, and a dim screen
    # makes the code's contrast too low to decode.  Set a fixed
    # brightness (0-255); 150-200 nits indoors is roughly 150-190.
    adb("shell", "settings put system screen_brightness_mode 0")
    adb("shell", "settings put system screen_brightness %d" % brightness)
    # WAKEUP (224) only wakes; the power key (26) toggles, so it would
    # turn an already-on screen off.  Only send it if the tablet is
    # actually asleep -- a key event can also disturb the display.
    if not is_awake():
        adb("shell", "input keyevent 224")
        time.sleep(1.0)


def build_code(payload, version, ec, module_px, quiet=4):
    """Draw the code at exactly module_px pixels per module."""
    qr = qrcode.QRCode(version=version, error_correction=ec,
                       box_size=1, border=quiet)
    qr.add_data(payload)
    qr.make(fit=False)
    img = qr.make_image(fill_color="black", back_color="white")
    n = len(qr.get_matrix())
    # qrcode hands back a 1-bit image, which PIL cannot paste without a
    # mask; make it a plain RGB image and scale it to the module size.
    img = img.convert("RGB").resize((n * module_px, n * module_px), 0)
    return img, n


def compose(code_img, background="white", scene="plain"):
    """Put the code on a screen-sized field.

    ``scene="plain"`` is the old behaviour: the code centred on a
    white or black field.

    ``scene="computer"`` reproduces a computer screen: a desktop
    gradient, a second window behind, a main window with a gradient
    title bar, the code on the white page inside it, and a gradient
    taskbar.  That is the realistic case -- the code is not the only
    bright thing in the picture, and the frame has other edges and
    gradients for the auto-exposure to trip over.
    """
    canvas = Image.new("RGB", (SCREEN_W, SCREEN_H), background)
    d = ImageDraw.Draw(canvas)

    if scene == "computer":
        for y in range(SCREEN_H):
            t = y / float(SCREEN_H)
            d.line([(0, y), (SCREEN_W, y)],
                   fill=(int(18 + 26 * t), int(26 + 34 * t),
                         int(44 + 52 * t)))
        d.rectangle([880, 150, 1280, 560], fill=(58, 66, 84))
        d.rectangle([880, 150, 1280, 190], fill=(76, 86, 108))
        wx0, wy0, wx1, wy1 = 70, 70, 1130, 720
        d.rectangle([wx0, wy0, wx1, wy1], fill=(236, 236, 236))
        for x in range(wx0, wx1):
            t = (x - wx0) / float(wx1 - wx0)
            d.line([(x, wy0), (x, wy0 + 40)],
                   fill=(int(38 + 70 * t), int(88 + 70 * t),
                         int(150 + 70 * t)))
        px0, py0, px1, py1 = wx0 + 40, wy0 + 70, wx1 - 40, wy1 - 40
        d.rectangle([px0, py0, px1, py1], fill=(255, 255, 255))
        cw, ch = code_img.size
        maxw, maxh = px1 - px0 - 40, py1 - py0 - 40
        if cw > maxw or ch > maxh:
            s = min(maxw / float(cw), maxh / float(ch))
            cw, ch = int(cw * s), int(ch * s)
            code_img = code_img.resize((cw, ch), 0)
        x = px0 + (px1 - px0 - cw) // 2
        y = py0 + (py1 - py0 - ch) // 2
        canvas.paste(code_img, (x, y))
        for x in range(SCREEN_W):
            t = x / float(SCREEN_W)
            d.line([(x, 760), (x, SCREEN_H)],
                   fill=(int(24 + 34 * t), int(26 + 36 * t),
                         int(34 + 44 * t)))
        for i in range(6):
            d.rectangle([16 + i * 54, 770, 50 + i * 54, 792],
                        fill=(96, 112, 140))
        return canvas, (x, y)

    w, h = code_img.size
    if w > SCREEN_W or h > SCREEN_H:
        s = min(SCREEN_W / float(w), SCREEN_H / float(h))
        w, h = int(w * s), int(h * s)
        code_img = code_img.resize((w, h), 0)
    x = (SCREEN_W - w) // 2
    y = (SCREEN_H - h) // 2
    canvas.paste(code_img, (x, y))
    return canvas, (x, y)


def screenshot(path):
    adb("shell", "screencap -p /sdcard/_qrshot.png")
    adb("pull", "/sdcard/_qrshot.png", path)
    im = Image.open(path).convert("L")
    # The screencap is in the tablet's native portrait orientation even
    # when the display is landscape, so it is rotated to match what is
    # actually on the panel.
    if im.size[1] > im.size[0]:
        im = im.rotate(-90, expand=True)
    return np.array(im)


def measure_pitch(a):
    """The module pitch on the screen, from the finder patterns."""
    b = (a < 128).astype(np.uint8)

    def runs(line):
        out = []
        cur = line[0]
        n = 0
        for v in line:
            if v == cur:
                n += 1
            else:
                out.append((cur, n))
                cur = v
                n = 1
        out.append((cur, n))
        return out

    from collections import Counter
    cnt = Counter()
    for y in range(a.shape[0]):
        r = runs(b[y])
        for i in range(len(r) - 4):
            if r[i][0] == 0:
                continue
            w = [c for _, c in r[i:i + 5]]
            if w[1] < 3 or w[3] < 3 or w[2] < 6:
                continue
            if (abs(w[0] - w[1]) <= max(1, w[1] // 3)
                    and abs(w[2] - 3 * w[1]) <= max(1, w[1] // 3)
                    and abs(w[3] - w[1]) <= max(1, w[1] // 3)
                    and abs(w[4] - w[1]) <= max(1, w[1] // 3)):
                cnt[w[1]] += 1
    if not cnt:
        return None, 0
    return cnt.most_common(1)[0][0], sum(cnt.values())


def show(png, name="code.png"):
    """Show the PNG in the gallery, at a known size.

    Two things have to be right or the tablet shows something else:
    the gallery resolves file:// names through the media store, so a
    freshly pushed file has to be scanned in, and it caches by name, so
    each code needs a name of its own.
    """
    remote = "/sdcard/" + name
    adb("push", png, remote)
    adb("shell", "am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE "
                 "-d file://" + remote)
    time.sleep(1.5)
    # Leave whatever the gallery was showing, so it does not simply
    # come back to the last photo.
    adb("shell", "input keyevent KEYCODE_BACK")
    time.sleep(0.8)
    adb("shell", "am start -a android.intent.action.VIEW "
                 "-d file://" + remote + " -t image/png "
                 "-n com.sec.android.gallery3d/.app.GalleryActivity")
    time.sleep(3.0)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--target")
    ap.add_argument("--file")
    ap.add_argument("--payload")
    ap.add_argument("--version", type=int, default=0)
    ap.add_argument("--ec", default="M")
    ap.add_argument("--module-px", type=int, default=6)
    ap.add_argument("--quiet", type=int, default=4)
    ap.add_argument("--background", default="white",
                    choices=["white", "black"])
    ap.add_argument("--scene", default="plain",
                    choices=["plain", "computer"],
                    help="plain: the code on a flat field; computer: a "
                         "desktop with a window, title bar and taskbar")
    ap.add_argument("--brightness", type=int, default=255,
                    help="tablet panel brightness 0-255 (150-190 is a "
                         "realistic indoor 150-200 nits)")
    ap.add_argument("--out", default="/tmp/opencode/tablet-show")
    ap.add_argument("--no-check", action="store_true")
    args = ap.parse_args()

    os.makedirs(args.out, exist_ok=True)

    if args.file:
        code = Image.open(args.file).convert("RGB")
        n = None
        payload = None
        want = args.module_px
    else:
        if args.target:
            with open(os.path.join(TARGETS, "%s.json" % args.target)) as f:
                meta = json.load(f)
            payload = meta["payload"]
            version = meta["version"]
            ec = EC_MAP[meta["error_correction"]]
        else:
            payload = args.payload or "KRUXCAM-TEST-0001"
            version = args.version or 2
            ec = EC_MAP[args.ec.upper()]
        want = args.module_px
        code, n = build_code(payload, version, ec, want, args.quiet)

    # The gallery scales the image to fit the screen, so the code on the
    # panel is smaller than it was drawn.  Draw it larger by whatever
    # factor the screen says it needs, and check again.
    draw_scale = 1.0
    info = {}
    for attempt in range(4):
        px = max(1, int(round(want * draw_scale)))
        img, n = build_code(payload, version, ec, px, args.quiet) \
            if payload else (code, n)
        canvas, origin = compose(img, args.background, args.scene)
        png = os.path.join(args.out, "code.png")
        canvas.save(png)
        wake(args.brightness)
        # A name that changes with the code, so the gallery does not
        # serve a cached copy of the previous one.
        name = "code-%d-%d.png" % (int(time.time()), attempt)
        show(png, name)
        # The gallery can leave the screen off if the tablet had gone
        # to sleep; wake it only if it actually is, then show the
        # gallery again.  No touch: this panel blinks on touch.
        if not is_awake():
            adb("shell", "input keyevent 224")
            time.sleep(0.5)
            show(png, name)
        if args.no_check:
            break
        shot = os.path.join(args.out, "screen.png")
        a = screenshot(shot)
        pitch, hits = measure_pitch(a)
        info = {
            "payload": payload,
            "modules": n,
            "requested_module_px": want,
            "drawn_module_px": px,
            "measured_module_px": pitch,
            "finder_hits": hits,
            "draw_scale": draw_scale,
            "screen": [SCREEN_W, SCREEN_H],
            "png": png,
        }
        if pitch == want:
            info["verified"] = True
            break
        if not pitch:
            # The measurement failed; the screen may be dark.
            info["verified"] = False
            info["error"] = "no finder patterns found on the screen"
            break
        # Work out the gallery's scale and correct for it.
        factor = want / float(pitch)
        draw_scale *= factor
        info["correction_applied"] = factor
        print("  the screen shows %s px/module, correcting by %.3f"
              % (pitch, factor))

    with open(os.path.join(args.out, "shown.json"), "w") as f:
        json.dump(info, f, indent=2)
    print(json.dumps(info))
    if payload:
        print("payload: %s" % payload)


if __name__ == "__main__":
    main()
