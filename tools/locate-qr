#!/usr/bin/env python3
"""Locate a QR code in a raw luma frame and measure it.

Reports the code's bounding box, its module pitch, the version it
implies, and the contrast between its paper and its modules.

  locate-qr <file.raw> <w> <h>
"""

import sys

import numpy as np


def locate(reg):
    """The bounding box of the code: the dense blob of structure."""
    paper = np.percentile(reg, 95)
    modules = np.percentile(reg, 5)
    th = (paper + modules) / 2
    b = (reg > th).astype(np.int32)
    # the code is a large square region; use the rows/columns that hold
    # structure, and take the biggest contiguous run.
    colcount = b.sum(axis=0)
    rowcount = b.sum(axis=1)

    def runs(v, frac=0.30):
        out = []
        start = None
        for i, x in enumerate(v):
            if x > frac * v.max() and x > 8:
                if start is None:
                    start = i
            else:
                if start is not None:
                    out.append((start, i - 1))
                    start = None
        if start is not None:
            out.append((start, len(v) - 1))
        return out

    return runs(colcount), runs(rowcount)


def finder_pitch(b):
    """The module pitch, from the 1:1:3:1:1 finder-pattern signature."""

    def runs(line):
        out = []
        cur = line[0]
        n = 0
        for v in line:
            if v == cur:
                n += 1
            else:
                out.append((cur, n))
                cur = v
                n = 1
        out.append((cur, n))
        return out

    hits = []
    for y in range(b.shape[0]):
        r = runs(b[y])
        for i in range(len(r) - 4):
            seq = r[i:i + 5]
            if seq[0][0] != 0:
                continue
            w = [c for _, c in seq]
            if w[1] == 0 or w[3] == 0:
                continue
            tol = max(1.0, w[1] * 0.6)
            if (abs(w[0] - w[1]) < tol and abs(w[2] - 3 * w[1]) < tol
                    and abs(w[3] - w[1]) < tol and abs(w[4] - w[1]) < tol):
                t = sum(w)
                if t >= 8:
                    hits.append(t / 7.0)
    return hits


def main():
    path, w, h = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
    d = np.frombuffer(open(path, "rb").read()[:w * h], dtype=np.uint8)
    a = d.reshape(h, w)

    cruns, rruns = locate(a)
    print("frame %dx%d  mean=%.1f max=%d" % (w, h, a.mean(), a.max()))
    if not cruns or not rruns:
        print("no structure found")
        return 1
    x0, x1 = max(cruns, key=lambda r: r[1] - r[0])
    y0, y1 = max(rruns, key=lambda r: r[1] - r[0])
    print("code bounding box: x %d..%d  y %d..%d  (%d x %d px)"
          % (x0, x1, y0, y1, x1 - x0 + 1, y1 - y0 + 1))

    reg = a[y0:y1 + 1, x0:x1 + 1]
    paper = np.percentile(reg, 95)
    modules = np.percentile(reg, 5)
    print("paper(p95)=%d  modules(p5)=%d  CONTRAST=%d levels"
          % (paper, modules, paper - modules))

    th = (paper + modules) / 2
    b = (reg > th).astype(np.uint8)
    hits = finder_pitch(b)
    if hits:
        p = float(np.median(hits))
        n = reg.shape[1] / p
        ver = (n - 17) / 4.0
        print("finder hits=%d  module pitch=%.2f px" % (len(hits), p))
        print("=> %.0f modules across => version %.1f (4v+17)"
              % (n, ver))
        print("=> pixels per module in the preview (720 wide): %.2f"
              % (reg.shape[1] * (720.0 / 1232.0) / n))
    else:
        print("no finder patterns at this contrast")
    return 0


if __name__ == "__main__":
    sys.exit(main())
