#!/usr/bin/env python3
"""Capture the camera corpus: frames of known QR targets at known exposures.

The corpus is the evidence base for every decoder and AE experiment, so
it is captured once and replayed offline afterwards.

The device does the socket work (camd's control socket lives there);
this script runs on the host, pushes a one-shot capture script to the
device, and pulls the result back.

  capture-corpus --targets /tmp/opencode/qr-targets \\
                 --out /tmp/opencode/corpus --distances 0.25,0.40,0.60
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

DEV = "0879524b0068abca"
REMOTE_SCRIPT = "/tmp/krux-capture-one.py"

# The exposure ladder, in sensor lines.  0x04e0 (1248) is the sensor's
# real maximum -- VMAX 0x04e4 minus the 4-line margin -- so the ladder
# ends exactly there.  Going above it would only record frames the
# sensor silently discards.
EXPOSURES = [0x0180, 0x0280, 0x0380, 0x0480, 0x0580, 0x0680, 0x0780,
             0x0880, 0x0980, 0x04e0]
GAIN = 0x00a5          # the vendor's default analog gain


def adb(*args, **kw):
    return subprocess.run(["adb", "-s", DEV] + list(args),
                          capture_output=True, text=True, **kw)


def push_capture_script():
    here = os.path.dirname(os.path.abspath(__file__))
    src = os.path.join(here, "capture-one.py")
    if not os.path.exists(src):
        raise SystemExit("capture-one.py must sit next to capture-corpus")
    subprocess.run(["adb", "-s", DEV, "push", src, REMOTE_SCRIPT],
                   check=True, capture_output=True)


def capture(exp, gain, outdir, name):
    """Set the exposure, ask for a dump, and pull the files back.

    The daemon writes the dump to /data/krux/ as root; the host pulls
    it, because the device-side interpreter runs as the shell user and
    cannot read those files (and the source frame is two megabytes
    against a one-megabyte default heap).
    """
    # The heap is sized generously: the device has 2 GB, and the
    # firmware itself is launched with -X heapsize=32M.
    r = adb("shell",
            "/data/krux/micropython -X heapsize=32M %s 0x%04x 0x%04x"
            % (REMOTE_SCRIPT, exp, gain))
    out = (r.stdout or "") + (r.stderr or "")
    if "ok" not in out:
        return None, out.strip()

    prev = os.path.join(outdir, name + "_preview.raw")
    full = os.path.join(outdir, name + "_source.raw")
    okp = adb("pull", "/data/krux/scan.raw", prev).returncode == 0
    okf = adb("pull", "/data/krux/scan_full.raw", full).returncode == 0
    if not (okp and okf):
        return None, "pull failed"
    return (prev, full), out.strip()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--targets", default="/tmp/opencode/qr-targets")
    ap.add_argument("--out", default="/tmp/opencode/corpus")
    ap.add_argument("--distances", default="0.25,0.40,0.60",
                    help="distances in metres, comma separated")
    ap.add_argument("--exposures", default="")
    ap.add_argument("--note", default="")
    ap.add_argument("--target-names", default="",
                    help="a comma-separated subset of target names")
    ap.add_argument("--interactive", action="store_true",
                    help="wait for ENTER before each capture")
    args = ap.parse_args()

    exposures = ([int(x, 0) for x in args.exposures.split(",")]
                 if args.exposures else EXPOSURES)
    distances = [float(x) for x in args.distances.split(",")]

    os.makedirs(args.out, exist_ok=True)
    with open(os.path.join(args.targets, "targets.json")) as f:
        targets = json.load(f)
    if args.target_names:
        want = set(args.target_names.split(","))
        targets = [t for t in targets if t["name"] in want]

    plan = []
    for t in targets:
        for d in distances:
            for e in exposures:
                plan.append({"target": t["name"], "distance_m": d,
                             "exposure": e, "gain": GAIN})
    with open(os.path.join(args.out, "capture-plan.json"), "w") as f:
        json.dump(plan, f, indent=2)
    print("capture plan: %d frames (%d targets x %d distances x %d exposures)"
          % (len(plan), len(targets), len(distances), len(exposures)))
    print("  plan written to %s" % os.path.join(args.out, "capture-plan.json"))
    print()

    push_capture_script()
    print("Press ENTER to start." if args.interactive else "Starting.")
    if args.interactive:
        input()

    results = []
    try:
        for i, item in enumerate(plan):
            name = "%s_d%03dmm_e%04x" % (
                item["target"], int(item["distance_m"] * 1000),
                item["exposure"])
            print("[%3d/%3d] %-34s" % (i + 1, len(plan), name), end="",
                  flush=True)
            if args.interactive:
                input("  aim the phone, then press ENTER: ")

            got, msg = capture(item["exposure"], item["gain"], args.out, name)
            rec = dict(item)
            rec["name"] = name
            rec["note"] = args.note
            if got is None:
                rec["ok"] = False
                rec["error"] = msg
                print("  FAILED (%s)" % msg)
            else:
                prev, full = got
                meta = {}
                r = adb("shell", "cat /data/krux/scan.meta 2>/dev/null")
                for k, v in re.findall(r"(\w+)=(-?\d+)", r.stdout):
                    meta[k] = int(v)
                rec["ok"] = True
                rec["camd_meta"] = meta
                print("  ok  %s" % (meta.get("mean", "?")))
            with open(os.path.join(args.out, name + ".json"), "w") as f:
                json.dump(rec, f, indent=2)
            results.append(rec)
    finally:
        pass

    with open(os.path.join(args.out, "index.json"), "w") as f:
        json.dump(results, f, indent=2)
    ok = sum(1 for r in results if r.get("ok"))
    print()
    print("captured %d/%d frames into %s" % (ok, len(results), args.out))


if __name__ == "__main__":
    main()
