#!/usr/bin/env python3
"""Where is the QR code in the frame, and is it all in?

Reports the code's position and how much of it is missing, so the
phone can be aimed by feedback rather than by guesswork.

  aim-check <file.raw> <width> <height>
"""

import os
import sys

import numpy as np


def runs(line):
    out = []
    cur = line[0]
    n = 0
    for v in line:
        if v == cur:
            n += 1
        else:
            out.append((cur, n))
            cur = v
            n = 1
    out.append((cur, n))
    return out


def finders(a, thr=128):
    """The finder patterns, by the 1:1:3:1:1 run signature."""
    d = (a < thr).astype(np.uint8)
    hits = []
    for y in range(d.shape[0]):
        rs = runs(d[y])
        for i in range(len(rs) - 4):
            if rs[i][0] != 0:
                continue
            w = [x for _, x in rs[i:i + 5]]
            if w[1] < 4 or w[3] < 4 or w[2] < 12:
                continue
            if not (abs(w[0] - w[1]) <= max(1, w[1] // 3)
                    and abs(w[2] - 3 * w[1]) <= max(1, w[1] // 3)
                    and abs(w[3] - w[1]) <= max(1, w[1] // 3)
                    and abs(w[4] - w[1]) <= max(1, w[1] // 3)):
                continue
            x0 = sum(c for _, c in rs[:i])
            hits.append((x0 + w[0] + w[1] // 2, y))
    groups = []
    for h in hits:
        for g in groups:
            if any(abs(h[0] - q[0]) < 20 and abs(h[1] - q[1]) < 20 for q in g):
                g.append(h)
                break
        else:
            groups.append([h])
    out = []
    for g in groups:
        if len(g) < 4:
            continue
        xs = [q[0] for q in g]
        ys = [q[1] for q in g]
        out.append((sum(xs) / len(xs), sum(ys) / len(ys), len(g)))
    return out


def main():
    path = sys.argv[1]
    w = int(sys.argv[2])
    h = int(sys.argv[3])
    a = np.frombuffer(open(path, "rb").read()[:w * h],
                      dtype=np.uint8).reshape(h, w)

    print("the frame is %dx%d" % (w, h))
    # the threshold matters: the code's modules are dark on a bright
    # screen, but the whole frame may be dark too.
    fs = []
    for thr in (128, 100, 150, 80, 180):
        fs = finders(a, thr)
        if len(fs) >= 3:
            print("  (threshold %d)" % thr)
            break
    if not fs:
        print("  no finder pattern found -- the code is not in view")
        return 1

    # the three finders of one code are the ones nearest to each other
    best = None
    for i in range(len(fs)):
        for j in range(i + 1, len(fs)):
            for k in range(j + 1, len(fs)):
                trio = [fs[i], fs[j], fs[k]]
                xs = [t[0] for t in trio]
                ys = [t[1] for t in trio]
                span = max(xs) - min(xs)
                if span < 20:
                    continue
                if best is None or span < best[0]:
                    best = (span, trio)
    if best is None:
        print("  the finders are too scattered to tell which code they are")
        return 1

    span, trio = best
    pitch = span / 104.0
    xs = [t[0] for t in trio]
    ys = [t[1] for t in trio]
    print("  %d finder pattern(s); the code's three are %d px apart"
          % (len(fs), span))
    print("  the module pitch is %.2f px" % pitch)
    for x, y, n in trio:
        print("     at %6.0f,%-6.0f  (%s, %s)"
              % (x, y, "left" if x < w / 2 else "right", "top" if y < h / 2 else "bottom"))

    # the code is 105 modules + a 4-module quiet zone on each side
    full = (105 + 8) * pitch
    x0 = min(xs) - 4 * pitch
    x1 = max(xs) + 104 * pitch + 4 * pitch
    print()
    print("  the code needs %.0f px of width (105 modules plus the quiet zone)" % full)
    print("  it starts at col %.0f and should end at col %.0f" % (x0, x1))
    missing_l = max(0, -x0)
    missing_r = max(0, x1 - (w - 1))
    missing_t = max(0, min(ys) - 4 * pitch)
    missing_b = max(0, (max(ys) + 104 * pitch + 4 * pitch) - (h - 1))
    print()
    if missing_l or missing_r or missing_t or missing_b:
        print("  IT IS CUT OFF:")
        if missing_l:
            print("     %.0f px are off the LEFT edge" % missing_l)
        if missing_r:
            print("     %.0f px are off the RIGHT edge" % missing_r)
        if missing_t:
            print("     %.0f px are off the TOP edge" % missing_t)
        if missing_b:
            print("     %.0f px are off the BOTTOM edge" % missing_b)
        print()
        print("  aim so the code sits in the middle of the frame;")
        print("  moving the tablet further away also helps.")
    else:
        print("  THE WHOLE CODE IS IN FRAME.")
        print("  it spans %.0f px, %.0f%% of the frame's width"
              % (full, 100 * full / w))
    return 0


if __name__ == "__main__":
    sys.exit(main())
