#!/usr/bin/env python3
"""Where is the QR code, and is it big enough to read?

Two measurements, because they fail in different ways:

  * the code's finder patterns, which say exactly where the code is
    and how much of it falls off each edge -- but they can only be
    found when the code is already big enough to resolve (roughly
    3 px per module);

  * the tablet's bright screen, which is always visible and gives
    the scale: the code is 105 modules of the screen's 1280 px, so
    the screen's width in the frame says how many pixels each module
    gets.

The second is what makes this usable when the phone is too far away:
it says how much closer the phone has to be.

  aim-check <file.raw> <width> <height>
"""

import os
import sys

import numpy as np

# The tablet's screen is 1280 screen px wide; the code is 105 modules
# of the screen's width (630 screen px at 6 px per module), plus a
# 4-module quiet zone on each side.
CODE_MODULES = 105
QUIET = 4
SCREEN_PX = 1280


def runs(line):
    out = []
    cur = line[0]
    n = 0
    for v in line:
        if v == cur:
            n += 1
        else:
            out.append((cur, n))
            cur = v
            n = 1
    out.append((cur, n))
    return out


def finders(a, thr=128):
    d = (a < thr).astype(np.uint8)
    hits = []
    for y in range(d.shape[0]):
        rs = runs(d[y])
        for i in range(len(rs) - 4):
            if rs[i][0] != 0:
                continue
            w = [x for _, x in rs[i:i + 5]]
            if w[1] < 4 or w[3] < 4 or w[2] < 12:
                continue
            if not (abs(w[0] - w[1]) <= max(1, w[1] // 3)
                    and abs(w[2] - 3 * w[1]) <= max(1, w[1] // 3)
                    and abs(w[3] - w[1]) <= max(1, w[1] // 3)
                    and abs(w[4] - w[1]) <= max(1, w[1] // 3)):
                continue
            x0 = sum(c for _, c in rs[:i])
            hits.append((x0 + w[0] + w[1] // 2, y))
    groups = []
    for h in hits:
        for g in groups:
            if any(abs(h[0] - q[0]) < 20 and abs(h[1] - q[1]) < 20 for q in g):
                g.append(h)
                break
        else:
            groups.append([h])
    out = []
    for g in groups:
        if len(g) < 4:
            continue
        xs = [q[0] for q in g]
        ys = [q[1] for q in g]
        out.append((sum(xs) / len(xs), sum(ys) / len(ys), len(g)))
    return out


def screen_box(a, thr=240):
    """The tablet's bright screen: the biggest bright region."""
    b = (a > thr)
    rows = b.sum(axis=1)
    cols = b.sum(axis=0)
    r = np.where(rows > a.shape[1] * 0.05)[0]
    c = np.where(cols > a.shape[0] * 0.05)[0]
    if not len(r) or not len(c):
        return None
    return int(c.min()), int(c.max()), int(r.min()), int(r.max())


def main():
    path = sys.argv[1]
    w = int(sys.argv[2])
    h = int(sys.argv[3])
    a = np.frombuffer(open(path, "rb").read()[:w * h],
                      dtype=np.uint8).reshape(h, w)

    print("the frame is %dx%d" % (w, h))

    # --- the scale, from the tablet's screen ---
    #
    # The source frame is the sensor's own landscape layout, and camd
    # rotates it 90 degrees counter-clockwise into the portrait
    # preview.  The tablet lies in landscape, so its screen's width
    # runs along the source's VERTICAL axis.
    box = screen_box(a)
    if box:
        x0, x1, y0, y1 = box
        sw = x1 - x0 + 1     # the source's horizontal extent
        sh = y1 - y0 + 1     # the source's vertical extent
        # the screen's width is the larger of the two, and it is the
        # one that runs along the source's vertical axis
        screen_w = max(sw, sh)
        # the code is 105/1280 of the screen's width
        code_px = screen_w * (CODE_MODULES / float(SCREEN_PX))
        ppm = code_px / CODE_MODULES
        print()
        print("the tablet's screen: %d px wide, %d px tall" % (sw, sh))
        print("  => the code is about %.0f px wide -> %.2f px per module"
              % (code_px, ppm))
        if ppm < 3:
            print("  TOO SMALL: the decoder needs about 3 px per module to")
            print("  find the code at all, and 5 to decode it reliably.")
            need = 5.0
            factor = need / ppm
            print("  The phone must be about %.1fx closer (or the code" % factor)
            print("  %.1fx bigger on the tablet)." % factor)
        elif ppm < 5:
            print("  marginal: about 5 px per module is wanted.")
        else:
            print("  big enough.")

    # --- the position, from the finders ---
    fs = []
    for thr in (128, 100, 150, 80, 180):
        fs = finders(a, thr)
        if len(fs) >= 3:
            break
    print()
    if len(fs) < 3:
        print("the code's finder patterns were not found")
        if fs:
            print("  (%d found -- the code is too small or too far)" % len(fs))
        return 1

    best = None
    for i in range(len(fs)):
        for j in range(i + 1, len(fs)):
            for k in range(j + 1, len(fs)):
                trio = [fs[i], fs[j], fs[k]]
                xs = [t[0] for t in trio]
                ys = [t[1] for t in trio]
                span = max(xs) - min(xs)
                if span < 20:
                    continue
                if best is None or span < best[0]:
                    best = (span, trio)
    if best is None:
        return 1
    span, trio = best
    pitch = span / 104.0
    xs = [t[0] for t in trio]
    ys = [t[1] for t in trio]
    print("the code: %d finder patterns, %.2f px per module" % (len(fs), pitch))
    for x, y, n in trio:
        print("   at %6.0f,%-6.0f  (%s, %s)"
              % (x, y, "left" if x < w / 2 else "right", "top" if y < h / 2 else "bottom"))

    full = (CODE_MODULES + 2 * QUIET) * pitch
    print()
    print("the whole code needs %.0f px of width" % full)
    if full > w:
        print("  MORE than the frame is wide: the code cannot fit.")
        print("  the phone must be further away, or the code smaller.")
    left = max(0, (4 * pitch) - min(xs))
    right = max(0, (max(xs) + 104 * pitch + 4 * pitch) - (w - 1))
    if left or right:
        print("  IT IS CUT OFF at the %s edge."
              % ("left" if left > right else "right"))
        print("     %.0f px are missing." % (left if left > right else right))
    else:
        print("  the whole code is in frame.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
