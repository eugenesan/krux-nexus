#!/usr/bin/env python3
"""Which way up is the QR code, in each picture?

A QR code's three finder patterns sit at the top-left, top-right and
bottom-left corners, and the alignment pattern at the bottom-right.  So
the code's orientation can be read directly off the image: find the
three 7x7 finder squares and see which corner each is in.

This is the unambiguous test of whether our preview is turned the right
way round.
"""

import os
import sys
from collections import defaultdict

import numpy as np


def runs(line):
    out = []
    cur = line[0]
    n = 0
    for v in line:
        if v == cur:
            n += 1
        else:
            out.append((cur, n))
            cur = v
            n = 1
    out.append((cur, n))
    return out


def finders(a, thr=128):
    """The finder patterns, as (x, y) centres.

    A finder is a 7x7 concentric square: a row through it has the
    1:1:3:1:1 signature, and the run of 3 is the middle bar.
    """
    d = (a < thr).astype(np.uint8)
    hits = []
    for y in range(d.shape[0]):
        rs = runs(d[y])
        for i in range(len(rs) - 4):
            if rs[i][0] != 0:
                continue
            w = [x for _, x in rs[i:i + 5]]
            if w[1] < 3 or w[3] < 3 or w[2] < 10:
                continue
            if not (abs(w[0] - w[1]) <= max(1, w[1] // 3)
                    and abs(w[2] - 3 * w[1]) <= max(1, w[1] // 3)
                    and abs(w[3] - w[1]) <= max(1, w[1] // 3)
                    and abs(w[4] - w[1]) <= max(1, w[1] // 3)):
                continue
            x0 = sum(c for _, c in rs[:i])
            hits.append((x0 + w[0] + w[1] // 2, y))
    return hits


def cluster(hits, r=12):
    """Group the hits into the individual finder patterns."""
    groups = []
    for h in hits:
        for g in groups:
            if any(abs(h[0] - q[0]) < r and abs(h[1] - q[1]) < r for q in g):
                g.append(h)
                break
        else:
            groups.append([h])
    out = []
    for g in groups:
        if len(g) < 3:
            continue
        xs = [q[0] for q in g]
        ys = [q[1] for q in g]
        out.append((sum(xs) / len(xs), sum(ys) / len(ys), len(g)))
    return out


def report(a, label):
    hits = finders(a)
    groups = cluster(hits)
    if len(groups) < 3:
        print("%-34s only %d finder pattern(s) found" % (label, len(groups)))
        return
    h, w = a.shape
    groups.sort(key=lambda g: g[1])
    print("%-34s %d finders:" % (label, len(groups)))
    for x, y, n in groups:
        # where is it, in the frame?
        side_x = "left" if x < w / 2 else "right"
        side_y = "top" if y < h / 2 else "bottom"
        print("     at %6.0f,%-6.0f  (%s, %s)  %d hits" % (x, y, side_x, side_y, n))


def main():
    # the Android photo
    from PIL import Image
    a = np.array(Image.open(sys.argv[1]).convert("L"))
    print("the Android photo %dx%d:" % (a.shape[1], a.shape[0]))
    report(a, "  the Android photo")

    print()
    # our preview
    p = np.frombuffer(open(sys.argv[2], "rb").read()[:720 * 960],
                      dtype=np.uint8).reshape(960, 720)
    print("our preview 720x960:")
    report(p, "  our preview")

    print()
    print("=== the same, from our SOURCE frame (the preview is the source")
    print("    rotated 90 degrees counter-clockwise) ===")
    s = np.frombuffer(open(sys.argv[3], "rb").read()[:1640 * 1232],
                      dtype=np.uint8).reshape(1232, 1640)
    report(s, "  our source frame")


if __name__ == "__main__":
    main()
